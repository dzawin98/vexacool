# Salin ke /etc/vexapacs/lic-manager.env (mode 600) atau .env di folder ini.
# Jangan pernah commit nilai asli. Nama variabel mengikuti .env Windows.
PORT=8898
HOST=127.0.0.1
SESSION_SECRET=ganti-dengan-acak-panjang
# kredensial login aplikasi (isi sesuai .env Windows yang sudah dipakai)
# APP_USER=
# APP_PASSWORD=
# Nama/identitas vendor untuk surat lisensi
# VENDOR_NAME=
