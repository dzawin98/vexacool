# /etc/vexapacs/vexa.env — environment bersama semua service VEXA di Linux.
# chmod 600, pemilik root (berisi kredensial). Salin jadi vexa.env lalu sesuaikan.
# CATATAN: nilai kredensial produksi tidak ditulis di repo ini.

NODE_ENV=production

# ---- Lisensi (WAJIB di Linux; default path di kode masih Windows) ----
VEXA_LICENSE_ENFORCE=true
VEXA_LICENSE_FILE=/var/lib/vexapacs/license.lic
VEXA_LICENSE_PUBLIC_KEY_PATH=/var/lib/vexapacs/public.pem
# fingerprint lisensi memakai hostname + MAC + platform, jadi lisensi Windows tidak
# otomatis valid di Linux. Lihat docs/LICENSE-ON-LINUX.md.

# ---- Direktori data (pengganti C:\ProgramData\VEXAPACS) ----
ProgramData=/var/lib/vexapacs
VEXA_PROGRAM_DATA_DIR=/var/lib/vexapacs
VELO_PROGRAM_DATA_DIR=/var/lib/vexapacs
VEXA_DOSE_RULES_PATH=/var/lib/vexapacs/dose-rules.json

# ---- Storage DICOM ----
DICOMWEB_PACS_STORAGE_PATH=/srv/vexadata
DICOM_STORAGE_PATH=/srv/vexadata

# ---- PostgreSQL (RIS + PACS) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=GANTI_PASSWORD_POSTGRES
DB_NAME=vexaris_db
PACS_DB_HOST=localhost
PACS_DB_PORT=5432
PACS_DB_USER=postgres
PACS_DB_PASS=GANTI_PASSWORD_POSTGRES
PACS_DB_NAME=vexapacs_db

# ---- Decoder JPEG 2000 (PACS) ----
# Pakai interpreter venv yang punya pylibjpeg-openjpeg (+ imagecodecs untuk HTJ2K)
DICOMWEB_JPEG2000_DECODER_PYTHON=/opt/vexapacs/venv/bin/python
DICOMWEB_J2K_PERSISTENT=true
DICOMWEB_J2K_WORKERS=4
DICOMWEB_J2K_WARM_WORKERS=4
DICOMWEB_J2K_IDLE_MS=1800000
DICOMWEB_DIMSE_STORAGE_COMPRESSION=true

# ---- Cache / latensi ----
DICOMWEB_FRAME_DISK_CACHE_ENABLED=true
DICOMWEB_FRAME_DISK_CACHE_DIR=/var/lib/vexapacs/frame-cache
DICOMWEB_FRAME_DISK_CACHE_MB=8192
DICOMWEB_FRAME_DISK_CACHE_DAYS=14
RIS_SLOW_REQUEST_MS=250
RIS_PREVIEW_CACHE_MS=600000
RIS_PREVIEW_CACHE_MAX=1500

# ---- DIMSE / MWL (nama variabel mengikuti kode, sama seperti .env Windows) ----
DIMSE_AE_TITLE=VEXA_PACS
DIMSE_PORT=5757
MWL_SCP_AET=NEXIARIS
MWL_SCP_BIND=0.0.0.0
MWL_SCP_PORT=5656

# ---- RIS backend (path internal; sesuaikan hanya kalau port diubah) ----
RIS_BACKEND_ROOT=http://127.0.0.1:3001
DICOMWEB_PACS_ROOT=http://127.0.0.1:5001
DICOMWEB_PACS_RS_ROOT=http://127.0.0.1:5001/rs
DICOMWEB_PACS_PACKAGE_ROOT=/opt/vexapacs/PACS

# ---- Rahasia integrasi: ISI dari .env Windows, jangan taruh nilai asli di repo ----
# PENTING soal NEXIA_RIS_SHARED_SECRET: kunci ini dibaca HANYA oleh viewer (5994/5992),
# sedangkan RIS mengirim panggilannya dengan VEXA_DESKTOP_RIS_SHARED_SECRET /
# VEXA_MOBILE_RIS_SHARED_SECRET. Jadi:
#   - biarkan KETIGANYA tidak diset  -> kedua sisi memakai nilai bawaan yang sudah cocok (aman, ini default),
#   - kalau mau nilai sendiri         -> isi KETIGANYA dengan nilai YANG SAMA PERSIS,
#   - JANGAN menulis "NEXIA_RIS_SHARED_SECRET=" (baris ada tapi nilai kosong): viewer lalu
#     mengharapkan string kosong dan SEMUA panggilan viewer<->RIS ditolak (halaman viewer error).
# NEXIA_RIS_SHARED_SECRET=...
# VEXA_DESKTOP_RIS_SHARED_SECRET=...
# VEXA_MOBILE_RIS_SHARED_SECRET=...
# SIMRS_API_KEY=...
# SIMRS_API_ROLE=administrator
# SIMRS_API_USERNAME=simrs-integration
# SIMRS_ALLOWED_IPS=127.0.0.1,IP-SIMRS-RS
# GOOGLE_CLIENT_ID=...

# ---- Integrasi (isi sesuai RS; kosong = nonaktif) ----
# SIMRS endpoint + api key (jangan commit nilainya)
# VEXA_SIMRS_API_KEY=
# SIMRS_DB_BRIDGE_HOST=
# WhatsApp: WAHA atau custom REST (lihat admin/README.md)
