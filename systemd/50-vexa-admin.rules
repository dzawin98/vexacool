// /etc/polkit-1/rules.d/50-vexa-admin.rules
// VEXA Admin (user vexa) boleh start/stop/restart unit vexa-* tanpa password.
// Tanpa ini, tombol start/stop di halaman admin akan gagal meski unit-nya benar.
polkit.addRule(function(action, subject) {
    if (!action.id.startsWith("org.freedesktop.systemd1.manage-units")) {
        return polkit.Result.NOT_HANDLED;
    }
    var unit = action.lookup("unit");
    if (subject.user === "vexa" && unit && unit.startsWith("vexa-")) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
