# VEXAPACS-RIS di CachyOS/Arch (systemd). Pasang ke /etc/systemd/system/.
# Environment bersama ada di /etc/vexapacs/vexa.env (chmod 600, berisi kredensial + lisensi).
[Unit]
Description=VEXAPACS Mobile Viewer (5992)
Documentation=file:/opt/vexapacs/docs/LINUX-INSTALL.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=vexa
Group=vexa
WorkingDirectory=/opt/vexapacs/MOBILITY VIEWER
EnvironmentFile=-/etc/vexapacs/vexa.env
Environment=NODE_ENV=production
Environment=VIEWER_DIST_DIR=/opt/vexapacs/MOBILITY VIEWER/dist
Environment=PORT=5992
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
# Log terpisah per service supaya bisa dibaca dari admin web / journalctl
StandardOutput=append:/var/log/vexapacs/viewer-mobile.out.log
StandardError=append:/var/log/vexapacs/viewer-mobile.err.log

[Install]
WantedBy=multi-user.target
