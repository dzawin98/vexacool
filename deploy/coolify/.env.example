# Salinan untuk validasi lokal:  docker compose -f docker-compose.coolify.yml --env-file deploy/coolify/.env.example config
# Di Coolify, variabel bertanda "Coolify generates" diisi otomatis lewat magic var
# SERVICE_PASSWORD_* / SERVICE_FQDN_*, jadi JANGAN ditulis manual di UI.

# ------------------------------------------------------------------ storage
# Satu-satunya knob penyimpanan. Ganti nilainya kalau pindah disk/NAS.
VEXA_DATA_ROOT=/data/vexa
# Port host untuk gateway RIS+Nginx (akses by IP: http://<IP>:8088/)
RIS_WEB_PORT=8088

# ------------------------------------------------------------------ lisensi
# false = jalan tanpa lisensi (uji coba). Produksi: lihat COOLIFY.md bagian Lisensi.
VEXA_LICENSE_ENFORCE=false

# ------------------------------------------------------------------ DIMSE / MWL
PACS_AE_TITLE=VEXA_PACS
PACS_DIMSE_PORT=5757
MWL_SCP_AET=NEXIARIS
MWL_SCP_PORT=5656

# ------------------------------------------------------------------ tuning
TZ=Asia/Jakarta
DICOMWEB_J2K_WORKERS=2
DICOMWEB_FRAME_DISK_CACHE_MB=4096
VEXA_THIN_VOLUME_CACHE_MAX=2
VEXA_VIEWER_JOB_CONCURRENCY=2
MPR_FRAME_CACHE_MB=512

# -------------------------------------------- Coolify generates (jangan diisi manual)
# SERVICE_FQDN_RISWEB_80
# SERVICE_FQDN_ECGVIEWER_7771
# SERVICE_PASSWORD_POSTGRES
# SERVICE_PASSWORD_JWT
# SERVICE_PASSWORD_PACSCRED
# SERVICE_PASSWORD_MWLKEY
# SERVICE_PASSWORD_TRAFFICKEY

# -------------------------------------------- nilai tetap hanya untuk tes lokal
SERVICE_PASSWORD_POSTGRES=ganti-password-panjang
SERVICE_PASSWORD_JWT=ganti-jwt-secret-panjang
SERVICE_PASSWORD_PACSCRED=ganti-pacs-credential-secret
SERVICE_PASSWORD_MWLKEY=ganti-mwl-internal-key
SERVICE_PASSWORD_TRAFFICKEY=ganti-traffic-internal-key
